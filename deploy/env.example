# Copy to .env next to compose.yaml. All optional for a try on this machine.

# --- Reaching it ------------------------------------------------------------------
# Listens on this machine by default. 0.0.0.0 opens it to the network, in plain HTTP:
# prefer the https profile, or your own reverse proxy (docs/DEPLOYMENT.md).
# LOSSCAPE_BIND=127.0.0.1
# LOSSCAPE_PORT=8080

# Where users reach the server. Needed for OAuth; https:// also makes cookies Secure.
# LOSSCAPE_PUBLIC_URL=https://losscape.example.com
# For the https profile: docker compose --profile https up -d
# LOSSCAPE_DOMAIN=losscape.example.com
# With your own reverse proxy on this machine (default: the https profile's Caddy):
# LOSSCAPE_TRUSTED_PROXIES=172.30.42.1

# --- Database passwords -----------------------------------------------------------
# The databases are only reachable from these containers, but do set your own for anything
# lasting: openssl rand -hex 32. Set them BEFORE the first start: they're fixed when the
# databases are created, and changing them later takes more than editing this file.
# LOSSCAPE_POSTGRES_PASSWORD=
# LOSSCAPE_CLICKHOUSE_PASSWORD=

# --- Your own look ----------------------------------------------------------------
# The name shown in the interface, browser tabs and sign-in page.
# LOSSCAPE_APP_NAME=Acme Experiments
# Images: put them in the branding/ folder next to compose.yaml, which is /branding inside
# the container. png, jpg, webp, avif, gif, svg or ico, up to 16 MB, read at startup: restart
# to change them (docker compose up -d --force-recreate losscape).
# The icon in browser tabs and next to the name (default: the built-in one).
# LOSSCAPE_FAVICON=/branding/favicon.svg
# The background of the sign-in and sign-up pages (default: plain).
# LOSSCAPE_AUTH_BACKGROUND=/branding/background.jpg

# --- Accounts ---------------------------------------------------------------------
# open: anyone who can reach the server may create an account; closed: only the first.
# LOSSCAPE_SIGNUP=open

# Sign-in with external providers. Leave LOSSCAPE_OAUTH unset to show no such buttons.
# Redirect URI to register with the provider: <PUBLIC_URL>/api/v0/auth/oauth/<id>/callback
# LOSSCAPE_OAUTH=google,github
# Any OpenID Connect provider (Google, Microsoft, GitLab, Keycloak, Authentik, Okta...):
# LOSSCAPE_OAUTH_GOOGLE_ISSUER=https://accounts.google.com
# LOSSCAPE_OAUTH_GOOGLE_CLIENT_ID=
# LOSSCAPE_OAUTH_GOOGLE_CLIENT_SECRET=
# LOSSCAPE_OAUTH_GOOGLE_NAME=Google
# GitHub (or GitHub Enterprise with _URL and _API_URL):
# LOSSCAPE_OAUTH_GITHUB_CLIENT_ID=
# LOSSCAPE_OAUTH_GITHUB_CLIENT_SECRET=

# --- Logs -------------------------------------------------------------------------
# RUST_LOG=info
