# Copy to .env next to compose.yaml. All optional for a try on this machine.

# --- Which image ------------------------------------------------------------------
# Built here by default. To run a published one instead: docker compose up -d --wait --no-build
# LOSSCAPE_IMAGE=madproton/losscape:0.2.2

# --- Reaching it ------------------------------------------------------------------
# Without HTTPS: plain HTTP on this machine only. 0.0.0.0 would open it to the network in the
# clear: use HTTPS below instead.
# LOSSCAPE_BIND=127.0.0.1
# LOSSCAPE_PORT=8080

# HTTPS through Caddy, on port 443 only; the server's own port is closed, and plain HTTP is
# served nowhere. Needs Docker Compose 2.24.4 or newer.
# COMPOSE_FILE=compose.yaml:deploy/compose.https.yaml
# LOSSCAPE_DOMAIN=losscape.example.com
# Where users reach the server. Needed for OAuth; https:// also makes cookies Secure, and tells
# browsers never to try plain HTTP for it (HSTS).
# LOSSCAPE_PUBLIC_URL=https://losscape.example.com
# acme: a certificate from Let's Encrypt (a public name pointing here, port 443 open to the
# internet). files: your own, e.g. for a name on internal DNS: certs/cert.pem (with its
# chain) and certs/key.pem next to compose.yaml, or in LOSSCAPE_CERTS_DIR.
# LOSSCAPE_CERTIFICATE=acme
# LOSSCAPE_CERTS_DIR=./certs
# Only on one interface of this machine, rather than all of them.
# LOSSCAPE_HTTPS_BIND=0.0.0.0

# With your own reverse proxy on this machine instead: its address as the containers see it.
# LOSSCAPE_TRUSTED_PROXIES=172.30.42.1

# --- Database passwords -----------------------------------------------------------
# The databases are only reachable from these containers, but do set your own for anything
# lasting: openssl rand -hex 32. Set them BEFORE the first start: they're fixed when the
# databases are created, and changing them later takes more than editing this file.
# LOSSCAPE_POSTGRES_PASSWORD=
# LOSSCAPE_CLICKHOUSE_PASSWORD=

# --- Your own look ----------------------------------------------------------------
# The name shown in the interface, browser tabs and sign-in page.
# LOSSCAPE_APP_NAME=Acme Experiments
# Images: put them in the branding/ folder next to compose.yaml, which is /branding inside
# the container. png, jpg, webp, avif, gif, svg or ico, up to 16 MB, read at startup: restart
# to change them (docker compose up -d --force-recreate losscape).
# The icon in browser tabs and next to the name (default: the built-in one).
# LOSSCAPE_FAVICON=/branding/favicon.svg
# The background of the sign-in and sign-up pages (default: plain).
# LOSSCAPE_AUTH_BACKGROUND=/branding/background.jpg

# --- Accounts ---------------------------------------------------------------------
# open: anyone who can reach the server may create an account; closed: only the first.
# LOSSCAPE_SIGNUP=open
# The first account needs a setup token, so that nobody else gets to be administrator by being
# first. The server makes one up and prints it (docker compose logs losscape), unless set here.
# LOSSCAPE_SETUP_TOKEN=
# forbidden: no administrator account, ever; one from before can't be used at all. Allowed again
# with none, an account becomes administrator with the setup token (Settings, Account).
# LOSSCAPE_ADMIN=allowed
# approval: users ask for new projects; the administrator accepts or rejects them. With
# LOSSCAPE_ADMIN=forbidden too, projects are locked: none can be created until restarted.
# LOSSCAPE_PROJECTS=open

# Sign-in with external providers. Leave LOSSCAPE_OAUTH unset to show no such buttons.
# Redirect URI to register with the provider: <PUBLIC_URL>/api/v1/auth/oauth/<id>/callback
# LOSSCAPE_OAUTH=google,github
# Any OpenID Connect provider (Google, Microsoft, GitLab, Keycloak, Authentik, Okta...):
# LOSSCAPE_OAUTH_GOOGLE_ISSUER=https://accounts.google.com
# LOSSCAPE_OAUTH_GOOGLE_CLIENT_ID=
# LOSSCAPE_OAUTH_GOOGLE_CLIENT_SECRET=
# LOSSCAPE_OAUTH_GOOGLE_NAME=Google
# GitHub (or GitHub Enterprise with _URL and _API_URL):
# LOSSCAPE_OAUTH_GITHUB_CLIENT_ID=
# LOSSCAPE_OAUTH_GITHUB_CLIENT_SECRET=

# --- Checkpoints ------------------------------------------------------------------
# What runs upload with run.log_checkpoint(). By default in the checkpoints volume; or in an
# S3-compatible store (AWS, MinIO, R2...), with its credentials: they never leave the server.
# LOSSCAPE_STORAGE=s3://my-bucket/losscape
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_ENDPOINT=https://minio.example.com   # anything but AWS itself
# The largest checkpoint accepted, all its files together.
# LOSSCAPE_MAX_CHECKPOINT_GB=100

# --- Logs -------------------------------------------------------------------------
# RUST_LOG=info
