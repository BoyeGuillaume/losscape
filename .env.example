# Copy to .env for local development. To run it in Docker instead, see deploy/env.example.
LOSSCAPE_LISTEN=0.0.0.0:8080
DATABASE_URL=postgres://losscape:losscape@localhost:5432/losscape
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=losscape
CLICKHOUSE_PASSWORD=losscape
CLICKHOUSE_DATABASE=losscape
RUST_LOG=info,losscape_server=debug

# Your own look: the name shown in the interface, the icon in browser tabs and next to the
# name, and the background of the sign-in and sign-up pages. Images are local files read at
# startup: png, jpg, webp, avif, gif, svg or ico, up to 16 MB.
# LOSSCAPE_APP_NAME=Acme Experiments
# LOSSCAPE_FAVICON=/path/to/favicon.svg
# LOSSCAPE_AUTH_BACKGROUND=/path/to/background.jpg

# --- Accounts ---------------------------------------------------------------------
# The first account created (web UI) becomes administrator and owns existing projects.
# open: anyone who can reach the server may create an account; closed: only the first.
LOSSCAPE_SIGNUP=open
# The first account needs a setup token: the server prints one at startup, unless set here.
# LOSSCAPE_SETUP_TOKEN=
# Where users reach the server. Required for OAuth; https:// makes cookies Secure.
# LOSSCAPE_PUBLIC_URL=https://losscape.example.com

# Sign-in with external providers (redirect URI: <PUBLIC_URL>/api/v0/auth/oauth/<id>/callback).
# LOSSCAPE_OAUTH=google,github
# Any OpenID Connect provider (Google, Microsoft, GitLab, Keycloak, Authentik, Okta...):
# LOSSCAPE_OAUTH_GOOGLE_ISSUER=https://accounts.google.com
# LOSSCAPE_OAUTH_GOOGLE_CLIENT_ID=...
# LOSSCAPE_OAUTH_GOOGLE_CLIENT_SECRET=...
# LOSSCAPE_OAUTH_GOOGLE_NAME=Google
# GitHub (or GitHub Enterprise with _URL / _API_URL):
# LOSSCAPE_OAUTH_GITHUB_CLIENT_ID=...
# LOSSCAPE_OAUTH_GITHUB_CLIENT_SECRET=...

# --- SDK, benchmarks, crash test ---------------------------------------------------
# An API key created in the web UI (Settings > API keys). Not read by the server.
# LOSSCAPE_API_KEY=df_...
